# Application bind address (host:port)
BIND_ADDRESS=0.0.0.0:3000

# Host port mapping (what port to expose on your machine)
HOST_PORT=3000

# Logging level
RUST_LOG=digging=debug,tower_http=debug

# Build configuration
# Set to "metrics" to enable metrics feature during build
FEATURES=

# ============================================================
# OpenTelemetry Configuration (for future use with metrics)
# ============================================================
# Uncomment and configure when you set up your OTLP exporter

# OTLP exporter endpoint (gRPC or HTTP)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io

# OTLP exporter headers (for authentication, API keys, etc.)
# Format: key1=value1,key2=value2
# Example for Honeycomb: x-honeycomb-team=YOUR_API_KEY
# OTEL_EXPORTER_OTLP_HEADERS=

# Service name for telemetry
# OTEL_SERVICE_NAME=digging

# ============================================================
# Observability Stack (if using Prometheus/Grafana)
# ============================================================
# GRAFANA_PASSWORD=admin
